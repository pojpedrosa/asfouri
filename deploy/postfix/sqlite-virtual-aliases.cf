# Postfix → every enabled asfouri address is piped into the Laravel app, which
# then stores it in the admin inbox and/or forwards it via the Mailgun API
# (see `php artisan mail:store`). Forwarding does NOT go through Postfix/SMTP,
# so DigitalOcean's outbound port-25 block is irrelevant.
# Install at /etc/postfix/sqlite-virtual-aliases.cf
dbpath = /var/www/asfouri-prod/database/database.sqlite
query = SELECT '%u@inbox.asfouri.local' FROM mail_addresses WHERE local_part = '%u' AND domain = '%d' AND enabled = 1 LIMIT 1
